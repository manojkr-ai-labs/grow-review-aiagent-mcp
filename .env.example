# Phase 2 theme labeling — Groq via LangChain (see llm/factory.py).
# Free key: https://console.groq.com/keys — no card required.
GROQ_API_KEY=gsk_your-key-here

# Phase 3 pulse composition — Gemini via LangChain.
# Free key: https://aistudio.google.com/apikey — no card required.
GEMINI_API_KEY=AIza-your-key-here

# Either key can be left as a placeholder: that stage falls back to its
# deterministic path and says so in the run's warnings.

# Optional: override a model for one run, per provider.
# LLM_MODEL=openai/gpt-oss-120b       # [llm]       — Groq, labeling
# GEMINI_MODEL=gemini-3.6-flash       # [pulse.llm] — Gemini, composition

# Optional: LangSmith tracing for prompt debugging
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2-your-key-here
# LANGCHAIN_PROJECT=reviewpulse

# Phase 5 hosted MCP (gmail-docs-mcp on Railway). Required for `reviewpulse run`
# without --dry-run. Not a Google token — it only authorizes POST /mcp.
# Generate with: openssl rand -hex 32  (must match the Railway MCP_AUTH_TOKEN)
MCP_AUTH_TOKEN=

# Phase 7 console avatar (optional).
# OPERATOR_INITIALS=MK

# Railway / deploy (optional). Local serve stays on 127.0.0.1 without these.
# REVIEWPULSE_BIND_ALL=1
# PORT=8080
# CORS_ORIGINS=https://your-web.up.railway.app,http://127.0.0.1:3000
# REVIEWPULSE_DATA_DIR=/persistent/data
# REVIEWPULSE_RUNS_DIR=/persistent/runs
# REVIEWPULSE_SETTINGS=/persistent/config/settings.toml
# HF_HOME=/persistent/hf
