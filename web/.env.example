# Optional. Leave unset so pipeline SSE uses the Next `/api/v1` rewrite (same origin).
# Set only if EventSource should hit FastAPI directly (requires CORS on the API).
# NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8000

# Production (web service). Used at `next build` for the `/api/v1` rewrite.
# REVIEWPULSE_API_ORIGIN=http://reviewpulse-api.railway.internal:8080

# Optional. Leave unset so the public console does not ask for a username or password.
# CONSOLE_BASIC_USER=
# CONSOLE_BASIC_PASSWORD=
